# Copy to backend/.env. All settings are optional; defaults use local Ollama.

# ollama (default) or openai
ZEROAI_LLM_PROVIDER=ollama
ZEROAI_OLLAMA_MODEL=gpt-oss:120b-cloud
ZEROAI_OLLAMA_BASE_URL=http://localhost:11434/v1

# These only seed the database on first start; afterwards use the Settings page.
# To use OpenAI instead:
# ZEROAI_LLM_PROVIDER=openai
# ZEROAI_OPENAI_API_KEY=sk-...
# ZEROAI_OPENAI_MODEL=gpt-4o-mini

# Max simultaneous LLM calls (1 is right for a single local model)
ZEROAI_LLM_MAX_CONCURRENCY=1

# Exact outbound allow-lists (JSON arrays). Include the built-ins when adding custom hosts.
ZEROAI_ALLOWED_FEED_HOSTS=["feeds.finance.yahoo.com","news.google.com","www.nasdaq.com"]
ZEROAI_ALLOWED_MODEL_ORIGINS=["http://localhost:11434","http://127.0.0.1:11434","http://[::1]:11434","http://host.docker.internal:11434","https://api.openai.com","https://ollama.com"]

# Feed resource limits
ZEROAI_NEWS_MAX_FEED_BYTES=1000000
ZEROAI_NEWS_MAX_SOURCES=20
ZEROAI_NEWS_FETCH_CONCURRENCY=5
